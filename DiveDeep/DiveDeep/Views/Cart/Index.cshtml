@using DiveDeep.ViewModels
@model PackageEquipmentViewData;

@section Title {

    <div class="cart-header">
        <div>
            <p class="mt-5"> <span class="special-text">Antal ting i kurv</span></p>
            <h1 class="SiteTitles">DIN KURV</h1>

        </div>

        <button type="button"
                class="align-content-end  btn btn-link text-secondary text-decoration-none"
                data-bs-toggle="modal"
                data-bs-target="#emptyCartModal">
            <i class="bi bi-trash"></i>Tøm kurv
        </button>
    </div>
}

@foreach (Equipment equipment in Model.CartEquipments)
{
    <p>@equipment.Id</p>
    <p>@equipment.Title</p>
    <p>@equipment.Description</p>
    <p>@equipment.Category</p>
    <p>@equipment.Price</p>
    <p>@equipment.ImageID</p>
}

@foreach (Package package in Model.CartPackages)
{
    <div class="mb-4 mt-4">
        <div class="package-box position-relative">
            <button type="button"
                    class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                    data-bs-toggle="modal"
                    data-bs-target="#removeModal">
            </button>

            <span class="badge rounded-pill px-3 py-2 package-label">@package.Category</span>
            <h2 class="package-title">@package.Title</h2>

            <div class="mb-3">
                @foreach (string equipment in package.Equipment)
                {
                    <span class="package-details">@equipment, </span>
                }
            </div>

            <div class="border-top border-dark pt-3">
                <span>
                    <div class="col-md-2">
                        <div class="input-group">
                            <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                            <input style="max-width:100px" type="text" class="form-control  form-control-sm text-center quantity-input" value="1">
                            <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                        </div>
                    </div>
                </span>
            </div>

        </div>
    </div>

}
