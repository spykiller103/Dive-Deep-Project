@using DiveDeep.ViewModels
@model PackageEquipmentViewData;

@section Title {

    <div class="cart-header">
        <div>
            <p class="mt-5"> <span class="special-text">Antal ting i kurv</span></p>
            <h1 class="SiteTitles">DIN KURV</h1>

        </div>

        <button type="button"
                class="align-content-end  btn btn-link text-secondary text-decoration-none"
                data-bs-toggle="modal"
                data-bs-target="#emptyCartModal">
            <i class="bi bi-trash"></i>
            Tøm kurv
        </button>

    </div>

}
<div style="background-color:red; height:600px; width:600px; color:white;">
    @if (Model != null)
    {
        <h2>Equipment</h2>

        @foreach (Equipment equipment in Model.CartEquipments)
        {
            <p>@equipment.Id</p>
            <p>@equipment.Title</p>
            <p>@equipment.Description</p>
            <p>@equipment.Category</p>
            <p>@equipment.Price</p>
            <p>@equipment.ImageID</p>
        }

        <h2>Packages</h2>

        @foreach (Package package in Model.CartPackages)
        {
            <p>@package.Id</p>
            <p>@package.Title</p>
            <p>@package.Price</p>
        }
    }
</div>

<div class="package-box position-relative">
    <button type="button"
            class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
            data-bs-toggle="modal"
            data-bs-target="#removeModal">
    </button>
    <span class="badge rounded-pill px-3 py-2 package-label">
        "kategori midlertidig"
    </span>
    <h2 class="package-title">Lille pakke</h2>
    <p class="package-details">
        Vådtragt: XXL, Finnestørrelse: 39
    </p>

    <hr />
    <div class="modal fade" id="emptyCartModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Tøm kurv?</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    Er du sikker på, at du vil fjerne alle varer fra kurven?
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Annuller
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmEmptyCart">
                        Tøm kurv
                    </button>

                </div>

            </div>
        </div>
    </div>

</div>