@model List<Package>
@using DiveDeep.Models
@using DiveDeep.Service
@inject PackageService PackageService

@section Title {
	<p class="mt-5"> <span class="special-text">LEJ PR DAG</span></p>
	<h1 class="SiteTitles">Dykker­pakker</h1>
	<p class="mb-5">Lej præcis det du mangler - fra maske til regulator</p>
}

<div class="row row-cols-1 row-cols-md-3 g-4 ">
	@foreach (Package package in Model)
	{
		<div class="col">
			<div class="card h-100">

				<div id="img_container">
					<a asp-controller="Packages"
					   asp-action="Details"
					   asp-route-id="@package.PackageId">

						<img src="@package.Image"
							 class="card-img-top package-img"
							 alt="Package" />
					</a>
				</div>
				<div class="card-body border-top border-dark d-flex flex-column">
					<div class="package-top">
						<p class="text-light mb-1">@package.Title</p>
					</div>
				</div>
			</div>
		</div>
	}