@model List<Package>

@section Title {
	<p class="mt-5"> <span class="special-text">LEJ PR DAG</span></p>
	<h1 class="SiteTitles">Dykker­pakker</h1>
	<p class="mb-5">Lej præcis det du mangler - fra maske til regulator</p>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach (Package package in Model)
	{
		<div class="col equipment-item">
			<div class="card h-100">
				<div id="img_container">
					<a asp-controller="Packages"
					   asp-action="Details"
					   asp-route-id="@package.PackageId">

						<img src="@package.Image"
							 class="card-img-top package-img"
							 alt="Equipment" />
					</a>
				</div>
				<div class="card-body d-flex flex-column">
					<p> <span class="special-text equipment-category">@package.Category</span></p>
					<p class="text-light equipment-title">@package.Title</p>
					<div class="package-equipment">
						@foreach (string equipment in package.Equipment)
						{
							<p class="text-secondary mb-2">@equipment</p>
						}
					</div>
					
				</div> <!-- .card-body -->
			</div> <!-- .card -->
		</div>
	}
</div>

