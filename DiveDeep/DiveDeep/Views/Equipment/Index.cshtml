@model List<Equipment>

@section Title {
    <br />
    <br />
    <p> <span class="special-text">LEJ PR DAG</span></p>
    <h1>Enkelt udstyr</h1>
    <p>Lej præcis det du mangler - fra maske til regulator</p>
    <br>
}



<div class="EquipmentButtonSite">
	<a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="reload">BCD</a>
	<a href="/categories/dykkerdragter" class="btn btn-primary btn-sm btn-equipment">Dykkerdragter</a>
	<a href="/categories/tanke" class="btn btn-primary btn-sm btn-equipment">Tanke</a>
	<a href="/categories/regulatorsæt" class="btn btn-primary btn-sm btn-equipment">Regulatorsæt</a>
	<a href="/categories/maske" class="btn btn-primary btn-sm btn-equipment">Maske/snorkel</a>
	<a href="/categories/Finner" class="btn btn-primary btn-sm btn-equipment">Finner</a>
</div>
<br />
<div class="row row-cols-1 row-cols-md-3 g-4 ">


    @foreach (Equipment equipment in Model)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@equipment.ImageID" class="card-img-top package-img" alt="...">
                <div class="card-body">
                    @* <p <span class="special-text">BEKLÆDNING</span></p> *@
                    <p> <span class="special-text">@equipment.Category</span></p>
                    <p class="text-light">@equipment.Title</p>
                    <p class="text-secondary">@equipment.Description</p>
                    <form asp-controller="equipment" asp-action="rent" method="post">
                  
                    <div class="package-footer mt-auto border-top border-dark">
                        <div class="align-items-center">
                            <div class="col-12">
                                <label class="form-label text-white small mb-1">Lejeperiode</label>
                                <div class="input-daterange input-group">
                                    <input type="text" class="input-sm form-control" name="start" />
                                    <span class="input-group-addon custom-text">to</span>
                                    <input type="text" class="input-sm form-control" name="end" />

                                </div>
                                @{
                                    int? key = equipment.Id;
                                    var dateErrors = ViewData.ModelState[key.ToString()]?.Errors;
                                    if (dateErrors != null && dateErrors.Count > 0)
                                    {
                                        <div class="text-danger small mt-1">@dateErrors[0].ErrorMessage</div>
                                    }
                                }

                            </div>

                        </div>


                        <p class="text-white">@equipment.Price<span class="text-info"> kr./dag</span></p>
                        <div class="card text-end">
                                <input type="hidden" name="id" value="@equipment.Id" />

                                <button type="submit" class="btn btn-info btn-rent">Lej</button>
                        </div>
                    </div>
                    </form>

                </div>
            </div>
        </div>
    }
</div>




@section Scripts {
    <script src="~/js/bootstrap-datepicker.min.js"></script>
    <script>
        $(function() {
            $('.input-daterange').datepicker({
                format: "dd/mm/yyyy",
                startDate: new Date(),
                autoclose: true,
                todayHighlight: true
            });
        });
    </script>
}