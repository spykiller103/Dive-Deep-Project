@model List<Equipment>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@section Title {
    <br />
    <br />
    <p> <span class="special-text">LEJ PR DAG</span></p>
    <h1>Enkelt udstyr</h1>
    <p>Lej præcis det du mangler - fra maske til regulator</p>
    <br>
}



<div class="EquipmentButtonSite">
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="BCD">BCD</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="Dykkerdragt">Dykkerdragter</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="Tanke">Tanke</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="Regulatorsæt">Regulatorsæt</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="Maske/Snorkel">Maske/snorkel</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index" asp-route-category="Finner">Finner</a>
    <a class="btn btn-primary btn-sm btn-equipment" asp-controller="Equipment" asp-action="Index">Alt</a>
</div>
<br />
<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (Equipment equipment in Model)
    {
        <div class="col equipment-item">
            <div class="card h-100">
                <div id="img_container">
                    <a asp-controller="Equipment"
                    asp-action="Details"
                    asp-route-id="@equipment.EquipmentId">

                        <img src="@equipment.Image"
                        class="card-img-top package-img"
                        alt="Equipment" />
                    </a>
                </div>
                <div class="card-body d-flex flex-column">
                    <p> <span class="special-text equipment-category">@equipment.Category</span></p>
                    <p class="text-light equipment-title">@equipment.Title</p>
                    <p class="text-secondary">@equipment.Description</p>          
                </div> <!-- .card-body -->
            </div> <!-- .card -->
        </div> 
    }
</div>
    