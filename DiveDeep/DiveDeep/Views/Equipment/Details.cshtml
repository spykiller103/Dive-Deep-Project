@using DiveDeep.Models;
@model Equipment;



@section Title
{

}

<div class="col">
    <div class="card h-100">
        <div class="card-body d-flex flex-column">
            <p> <span class="special-text">Title: @Model.Title</span></p>
            <p> <span class="special-text">Varenummer: @Model.EquipmentId</span></p>
            <img src="@Model.Image"
                 class="card-img-top package-img"
                 alt="Equipment" />
            <p class="text-secondary">@Model.Description</p>
            <form asp-controller="equipment" asp-action="rent" method="post" class="w-100">

                <div class="package-footer mt-auto border-top border-dark">
                    <div class="mb-2">
                        @{
                            List<string> sizes = Model.SizeList ?? new List<string> { "S", "M", "L", "XL" };
                        }
                        <div class="btn-group" role="group">
                            @for (int i = 0; i < sizes.Count; i++)
                            {
                                string s = sizes[i];
                                string id = $"esize_{Model.EquipmentId}_{s}";
                                string checkedAttr = i == 0 ? "checked" : "";
                                <input type="radio" class="btn-check" name="size" id="@id" autocomplete="off" value="@s" @checkedAttr />
                                <label class="size-btn" for="@id">@s</label>
                            }
                        </div>
                    </div>

                  
                <div class="package-footer mt-auto border-top border-dark">
                    <div class="align-items-center">
                        <div class="col-12">
                            <label class="form-label text-white small mb-1">Lejeperiode</label>
                            <div class="input-daterange input-group">
                                <input type="text" class="input-sm form-control" name="start" />
                                <span class="input-group-addon custom-text">to</span>
                                <input type="text" class="input-sm form-control" name="end" />

                            </div>
                            @{
                                int? key = Model.EquipmentId;
                                var dateErrors = ViewData.ModelState[key.ToString()]?.Errors;
                                if (dateErrors != null && dateErrors.Count > 0)
                                {
                                    <div class="text-danger small mt-1">@dateErrors[0].ErrorMessage</div>
                                }
                            }

                        </div>
                    </div>

                    <p class="text-white">@Model.Price<span class="text-info"> kr./dag</span></p>

                    <input type="hidden" name="id" value="{@Model.EquipmentId"} />
                    <button type="submit" class="btn btn-info btn-rent w-100">Lej</button>
                </div>
            </form>
        </div>
    </div>
</div>

</div>




@section Scripts {
    <script src="~/js/bootstrap-datepicker.min.js"></script>
    <script>
        $(function() {
            $('.input-daterange').datepicker({
                format: "dd/mm/yyyy",
                startDate: new Date(),
                autoclose: true,
                todayHighlight: true
            });
        });
    </script>
}