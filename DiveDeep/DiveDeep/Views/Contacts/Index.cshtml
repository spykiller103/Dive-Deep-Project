<h1 class="SiteTitles">Kontakt Os</h1>
<p>Spørgsmål om udstyr, størrelser eller booking? Vi svarer inden for 24 timer.</p>
<div class="row">
    <div class="col-md-8">
        <div class="ContactBox">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="navnInput" class="form-label">Navn</label>
                    <input type="text" class="form-control ContactInput" id="navnInput" placeholder="Anders Andersen">
                </div>
                <div class="col-md-6">
                    <label for="exampleFormControlInput1" class="form-label">Email address</label>
                    <input type="email" class="form-control ContactInput" id="exampleFormControlInput1" placeholder="name@example.com">
                </div>
            </div>
            <div class="mb-3">
                <label>Emne</label>
                <select class="ContactSelect">
                    <option selected disabled hidden>Vælg emne...</option>
                    <option>Spørgsmål om pakker</option>
                    <option>Spørgsmål om enkelt udstyr</option>
                    <option>Booking og afhentning</option>
                    <option>Andet</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="exampleFormControlTextarea1" class="form-label">Besked</label>
                <textarea class="form-control ContactInput" id="exampleFormControlTextarea1" rows="8" placeholder="Skriv din besked her..."></textarea>
            </div>
            <div>
                <a class="btn btn-primary">Send besked</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="ContactBox1">
            <div class="IconBox">
                <i class="bi bi-geo-alt"></i>
            </div>
            <div class="InfoTextWrapper">
                <p class="InfoTitle">Adresse</p>
                <p class="InfoText">Dykkervej 10, 5000 Odense C</p>
            </div>
        </div>

        <div class="ContactBox1">
            <div class="IconBox">
                <i class="bi bi-telephone"></i>
            </div>
            <div class="InfoTextWrapper">
                <p class="InfoTitle">Telefon</p>
                <p class="InfoText">+45 60 70 80 90</p>
            </div>
        </div>

        <div class="ContactBox1">
            <div class="IconBox">
                <i class="bi bi-envelope"></i>
            </div>
            <div class="InfoTextWrapper">
                <p class="InfoTitle">E-mail</p>
                <p class="InfoText">info@divedeep.dk</p>
            </div>
        </div>

        <div class="ContactBox1">
            <div class="IconBox">
                <i class="bi bi-clock"></i>
            </div>
            <div class="InfoTextWrapper">
                <p class="InfoTitle">Åbningstider</p>
                <p class="InfoText">Man–fre: 10.00 - 17.30</p>
                <p class="InfoText">Lørdag: 10.00 - 14.00</p>
                <p class="InfoText">Søndag: Lukket</p>
            </div>
        </div>
    </div>
</div>