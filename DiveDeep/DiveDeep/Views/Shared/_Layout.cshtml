<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DiveDeep</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiveDeep.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar" data-bs-theme="dark">
        <div class="container-fluid justify-content-center">


            <div class="d-flex align-items-center justify-content-center flex-wrap gap-3">
                <!-- Logo -->
                <a href="/" class="navbar-brand m-0">
                    <img src="/Content/Images/DiveDeepLogo.png" class="logo" alt="DiveDeep Logo" />
                </a>

                <!-- SearchBar -->
                <div class="searchContainer">
                    <i class="bi bi-search"></i>

                    <input class="searchBar form-control"
                           type="search"
                           placeholder="Søg udstyr og pakker ..."
                           aria-label="Search" />
                </div>

                <!-- MenuBox 1 -->
                <div class="borderBox">
                    <div class="navbarHeader navbar-nav d-flex flex-row gap-5">
                        <a class="nav-link active" aria-current="page" asp-controller="Packages" asp-action="Index">Pakker</a>
                        <a class="nav-link" asp-controller="Equipment" asp-action="Index">Udstyr</a>
                        <a class="nav-link" asp-controller="AboutUs" asp-action="Index">Om os</a>
                        <a class="nav-link" asp-controller="Contacs" asp-action="Index">Kontakt</a>
                    </div>
                </div>

                <!-- Login -->
                <div class="borderBox login">
                    <div class="navbarHeader navbar-nav">
                        <a class="nav-link" href="#">Log ind</a>
                    </div>
                </div>

                <!-- ShoppingCart -->
                <div class="borderBox cartBox">
                    <div class="navbarHeader navbar-nav">
                        <a href="/" class="navbar-brand m-0 p-0 d-flex align-items-center">
                            <img src="/Content/Images/ShoppingCart.png" class="shoppingCart" alt="Cart" />
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </nav>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="container-fluid p-0 flex-shrink-0" style="background:rgb(17, 21, 29);">
        <footer class="row row-cols-1 row-cols-md-4 justify-content-evenly text-center py-5 m-0 border-top border-dark">
            <div class="col mb-3 custom-footer-text2">
                <h5>Navigation</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 custom-footer-text">Forside</a></li>
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 custom-footer-text">Pakker</a></li>
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 custom-footer-text">Udstyr</a></li>
                    <li class="nav-item mb-2"><a class="nav-link p-0 custom-footer-text" asp-controller="AboutUs" asp-action="Index">Om Os</a></li>
                    <li class="nav-item mb-2"><a class="nav-link p-0 custom-footer-text" asp-controller="Contacts" asp-action="Index">Kontakt</a></li>
                </ul>
            </div>

            <div class="col mb-3 custom-footer-text2">
                <h5>Konto</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 custom-footer-text">Log Ind</a></li>
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 custom-footer-text">Opret Konto</a></li>
                </ul>
            </div>

            <div class="col mb-3 custom-footer-text2">
                <h5>Åbningstider</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2 custom-footer-text2">Mandag-fredag: 10.00 - 17.30</li>
                    <li class="nav-item mb-2 custom-footer-text2">Lørdag: 10.00 - 14.00</li>
                    <li class="nav-item mb-2 custom-footer-text2">Søndag: Lukket</li>
                </ul>
            </div>


            <div class="col mb-3 custom-footer-text2">
                <h5>Kontakt</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2 custom-footer-text2">Dykkervej 10, 5000 Odense C</li>
                    <li class="nav-item mb-2 custom-footer-text2">CVR-nummer: 81828384</li>
                    <li class="nav-item mb-2 custom-footer-text2">+45 60 70 80 90</li>
                    <li class="nav-item mb-2 custom-footer-text2">info@divedeep.dk</li>
                </ul>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>