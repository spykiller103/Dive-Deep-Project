@using DiveDeep.ViewModels;
@model BookingApplicationUserViewData;

@section Title {
    <a class="btn btn-primary mt-3" href="/Identity/Account/Manage">Back to profile</a>

    <h1 class="mt-4 SiteTitles">@Model.ApplicationUser.FullName</h1>
    <p>@Model.ApplicationUser.Email</p>
}

<div class="row row-cols-1 row-cols-md-3 g-3 gap-3">
    <div class="mt-4 profile-info">
        <h3>Aktive lejemål</h3>
        <p>@Model.ActiveBookingCount</p>
    </div>

    <div class="mt-4 profile-info">
        <h3>Kommende lejemål</h3>
        <p>@Model.UpcomingBookingCount</p>
    </div>

    <div class="mt-4 profile-info">
        <h3>Afsluttede lejemål</h3>
        <p>@Model.CompletedBookingCount</p>
    </div>

    <div class="mt-4 profile-info">
        <h3>Samlede lejeperioder</h3>
        <p>@Model.TotalRentalPeriods</p>
    </div>
</div>


<h2 class="text-light mt-5">Lejer lige nu</h2>

@foreach (Booking booking in Model.ActiveBookings)
{
    <div class="booking-card mt-3 p-3">
        <div class="booking-header">

            @if (booking.CartItems.Any())
            {
                CartItem? firstItem = booking.CartItems
                    .FirstOrDefault(c => c.Package != null || c.Equipment != null);

                int totalPrice = booking.CartItems
                    .Sum(c => c.Package != null ? c.Package.Price * c.TotalDays : c.Equipment != null ? c.Equipment.Price * c.TotalDays : 0);

                @if (firstItem?.BookingId != null)
                {
                    CartItem leastDayItem = booking.CartItems
                        .OrderBy(c => c.EndDate)
                        .First();

                    int daysLeft = (leastDayItem.EndDate.Date - DateTime.Today).Days + 1;

                    <h3>DYK-@firstItem.BookingId</h3>

                    <div class="booking-info">
                        <h3>@totalPrice kr.</h3>
                        <h3 class="badge rounded-pill px-3 py-2 package-label">@daysLeft dag(e) tilbage</h3>
                    </div>
                }
            }
        </div>
        <p>
            @booking.CartItems.Min(c => c.StartDate).ToString("d. MMMM yyyy")
            →
            @booking.CartItems.Max(c => c.EndDate).ToString("d. MMMM yyyy")
        </p>

        <hr />



        <div class="booking-items">

            @foreach (CartItem cartItem in booking.CartItems)
            {
                <div>
                    @if (cartItem.Package != null)
                    {
                        <p>
                            <span class="badge rounded-pill px-3 py-2 package-label">@cartItem.Package.Category </span>
                            @cartItem.Package.Title
                            <br />

                            @foreach (string equipment in cartItem.Package.Equipment)
                            {
                                <span class="package-details">@equipment</span>

                                @foreach (var sizeEntry in cartItem.EquipmentSizes)
                                {
                                    @if (equipment.Contains(sizeEntry.EquipmentName) || sizeEntry.EquipmentName.Contains(equipment))
                                    {
                                        <span class="package-details"> - @sizeEntry.SelectedSize</span>
                                    }
                                }

                                <br />
                            }
                        </p>
                    }
                </div>
            }

        </div>
    </div>
}


<h2 class="text-light mt-5">Kommende lejemål</h2>

@foreach (var booking in Model.UpcomingBookings)
{
    <div class="booking-card mt-3">

        <div class="booking-header">
            <div>
                @if (booking.CartItems.Any())

                {
                    var firstItem = booking.CartItems
                        .FirstOrDefault(c => c.Package != null || c.Equipment != null);

                    @if (firstItem?.Package != null)
                    {
                        <h3>@firstItem.Package.Title</h3>
                    }
                    else if (firstItem?.Equipment != null)
                    {
                        <h3>@firstItem.Equipment.Title</h3>
                    }

                    <p>
                        @booking.CartItems.Min(c => c.StartDate).ToString("d. MMMM yyyy")
                        →
                        @booking.CartItems.Max(c => c.EndDate).ToString("d. MMMM yyyy")
                    </p>
                }
            </div>
        </div>

        <div class="booking-items">

            @foreach (var item in booking.CartItems)
            {
                <div class="booking-item">
                    @if (item.Package != null)
                    {
                        <p>
                            <span class="badge rounded-pill px-3 py-2 package-label">@item.Package.Category </span>
                            @item.Package.Title

                            <br />

                            @foreach (string equipment in item.Package.Equipment)
                            {
                                <span class="package-details">@equipment</span>
                            }

                            @if (item.EquipmentSizes != null && item.EquipmentSizes.Count > 0)
                            {
                                <div class="mb-3">
                                    <p class="text-white small mb-2">Valgte størrelser:</p>

                                    @foreach (var sizeEntry in item.EquipmentSizes)
                                    {
                                        <div class="mb-1">
                                            <span class="text-secondary small">@sizeEntry.EquipmentName: </span>
                                            <span class="text-info small">@sizeEntry.SelectedSize</span>
                                        </div>
                                    }
                                </div>
                            }
                        </p>
                    }

                    else if (item.Equipment != null)
                    {
                        <p>
                            <span class="badge rounded-pill px-3 py-2 equipment-label">Udstyr</span>
                            @item.Equipment.Title
                            <br />

                            @if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                            {
                                <div class="mb-2">
                                    <span class="text-white small">Størrelse: </span>
                                    <span class="text-info small">@item.SelectedSize</span>
                                </div>
                            }
                        </p>
                    }

                    <div>
                        @item.TotalDays dage · afleveres
                        @item.EndDate.ToString("d. MMMM yyyy")
                    </div>

                </div>
            }

        </div>
    </div>
}


<h2 class="text-light mt-5">Lejehistorik</h2>

@foreach (var booking in Model.CompletedBookings)
{
    <div class="booking-card mt-3">

        <div class="booking-header">
            <div>
                @if (booking.CartItems.Any())

                {
                    var firstItem = booking.CartItems
                        .FirstOrDefault(c => c.Package != null || c.Equipment != null);

                    @if (firstItem?.Package != null)
                    {
                        <h3>@firstItem.Package.Title</h3>
                    }
                    else if (firstItem?.Equipment != null)
                    {
                        <h3>@firstItem.Equipment.Title</h3>
                    }

                    <p>
                        @booking.CartItems.Min(c => c.StartDate).ToString("d. MMMM yyyy")
                        →
                        @booking.CartItems.Max(c => c.EndDate).ToString("d. MMMM yyyy")
                    </p>
                }
            </div>
        </div>

        <div class="booking-items">

            @foreach (var item in booking.CartItems)
            {
                <div class="booking-item">
                    @if (item.Package != null)
                    {
                        <p>
                            <span class="badge rounded-pill px-3 py-2 package-label">@item.Package.Category </span>
                            @item.Package.Title
                            <br />

                            @foreach (string equipment in item.Package.Equipment)
                            {
                                <span class="package-details">@equipment</span>
                            }

                            @if (item.EquipmentSizes != null && item.EquipmentSizes.Count > 0)
                            {
                                <div class="mb-3">
                                    <p class="text-white small mb-2">Valgte størrelser:</p>

                                    @foreach (var sizeEntry in item.EquipmentSizes)
                                    {
                                        <div class="mb-1">
                                            <span class="text-secondary small">@sizeEntry.EquipmentName: </span>
                                            <span class="text-info small">@sizeEntry.SelectedSize</span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                            {
                                <div class="mb-2">
                                    <span class="text-white small">Størrelse: </span>
                                    <span class="text-info small">@item.SelectedSize</span>
                                </div>
                            }
                        </p>
                    }
                    else if (item.Equipment != null)
                    {
                        <p>
                            <span class="badge rounded-pill px-3 py-2 equipment-label">Udstyr</span>
                            @item.Equipment.Title
                            <br />

                            @if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                            {
                                <div class="mb-2">
                                    <span class="text-white small">Størrelse: </span>
                                    <span class="text-info small">@item.SelectedSize</span>
                                </div>
                            }
                        </p>
                    }

                    <div>
                        @item.TotalDays dage · afleveret
                        @item.EndDate.ToString("d. MMMM yyyy")
                    </div>

                </div>
            }

        </div>
    </div>
}