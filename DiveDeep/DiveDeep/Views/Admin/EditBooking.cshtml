@using DiveDeep.DTOs
@model List<BookingDTO>

@{
    ViewData["Title"] = "Bookings";
}

@section Title {
    <h1 class="mt-4">Alle bookings</h1>
}

<div class="d-flex flex-wrap gap-3">

    <table class="table">
        <tr>
            <th>Booking</th>
            <th>Bruger</th>
            <th>Startdato</th>
            <th>Slutdato</th>
            <th>Pris</th>
            <th></th>
        </tr>

        @foreach (var booking in Model)
        {
            var cartItems = booking.CartItems ?? new List<CartItemDTO>();

            var totalPrice = cartItems.Sum(c =>
                c.Package != null
                    ? c.Package.Price * c.TotalDays
                    : c.Equipment != null
                        ? c.Equipment.Price * c.TotalDays
                        : 0);

            <tr>
                <td>
                    Booking-@booking.BookingId
                </td>

                <td>
                    @booking.ApplicationUser?.Email
                </td>

                <td>
                    @if (cartItems.Any())
                    {
                        @cartItems.Min(c => c.StartDate).ToString("d. MMMM yyyy")
                    }
                </td>

                <td>
                    @if (cartItems.Any())
                    {
                        @cartItems.Max(c => c.EndDate).ToString("d. MMMM yyyy")
                    }
                </td>

                <td>
                    @totalPrice kr.
                </td>

                <td>
                    <a asp-controller="Admin"
                       asp-action="EditBookingDetails"
                       asp-route-id="@booking.BookingId"
                       class="btn btn-link">
                        Se booking
                    </a>
                    <form asp-controller="Admin"
                        asp-action="DeleteBooking"
                        asp-route-id="@booking.BookingId"
                        method="post" style="display:inline;">
                        <button type="submit" class="btn btn-link text-danger">
                            Slet 
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>

</div>

