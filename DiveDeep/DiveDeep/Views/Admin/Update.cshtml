@model List<Equipment>

@{
    ViewData["Title"] = "Tilpas udstyr";
}

@section Title {
    <h1 class="mt-4">Tilpas udstyr</h1>
}

<div class="d-flex flex-wrap gap-3">

    
    <table class="table">
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Price</th>
            <th>Amount</th>
            <th></th>
        </tr>

        @foreach (var equipment in Model)
        {
            <tr>
                <td>@equipment.Title</td>
                <td>@equipment.Category</td>
                <td>@equipment.Price kr.</td>
                <td>@equipment.Amount</td>

                <td>
                    <a asp-controller="Admin"
                       asp-action="UpdateEquipment"
                       asp-route-id="@equipment.EquipmentId"
                       class="btn btn-link">
                        Rediger
                    </a>

                    <form asp-controller="Admin"
                          asp-action="DeleteEquipment"
                          asp-route-id="@equipment.EquipmentId"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-link text-danger">
                            Slet
                        </button>

                    </form>
                </td>
            </tr>
        }
    </table>
    

</div>
